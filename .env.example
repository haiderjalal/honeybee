# Public site URL — used for canonical URLs, sitemap, Open Graph and llms.txt (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: WhatsApp number in international format (digits only), shown as a contact link.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Resend (https://resend.com) — order requests are emailed to INQUIRY_TO_EMAIL.
# The FROM address must use a domain verified in your Resend account.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="HonyB Orders <orders@example.com>"
INQUIRY_TO_EMAIL=

# Optional: "console" logs order emails instead of sending them (local development and e2e tests).
# Defaults to "resend" when RESEND_API_KEY is set, otherwise "console".
EMAIL_TRANSPORT=
